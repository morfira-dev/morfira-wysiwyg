{
  "name": "morfira-wysiwyg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts && tsc -p packages/core && tsc -p packages/plugins && tsc -p packages/vue && tsc -p packages/react && tsc -p packages/web-component && pnpm --filter @morfira-dev/wysiwyg-svelte build && tsx scripts/build-angular.ts && tsx scripts/size.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./packages/svelte/tsconfig.json && vue-tsc --noEmit -p apps/docs/tsconfig.json",
    "test": "playwright test",
    "check": "pnpm run check:static && pnpm test",
    "check:static": "pnpm run check:project && pnpm run test:consumers && pnpm run build && pnpm run package:check && pnpm run check:tree-shaking && pnpm run typecheck",
    "release": "tsx scripts/release.ts",
    "docs:dev": "pnpm run build && vitepress dev apps/docs --host 127.0.0.1",
    "docs:build": "pnpm run build && pnpm run docs:build:site",
    "docs:build:site": "vitepress build apps/docs",
    "docs:preview": "vite preview --outDir apps/docs/.vitepress/dist --host 127.0.0.1 --port 4173 --strictPort",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "check:project": "tsx scripts/check-project.ts",
    "release:plan": "tsx scripts/release.ts --dry-run",
    "test:release": "tsx scripts/tests/index.ts",
    "package:check": "tsx scripts/check-packages.ts",
    "check:tree-shaking": "tsx scripts/check-tree-shaking.ts",
    "benchmark": "tsx scripts/benchmarks/run.ts",
    "test:consumers": "tsx scripts/consumers/toolchain.test.ts",
    "consumers:check": "tsx scripts/consumers/index.ts",
    "consumers:angular22": "tsx scripts/consumers/index.ts --angular22",
    "release:notify": "tsx scripts/release-notification.ts"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@babel/core": "7.29.7",
    "@morfira-dev/wysiwyg": "workspace:*",
    "@nuykon/semantic-release-tg-bot": "1.0.0",
    "@playwright/test": "^1.56.0",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "esbuild": "^0.25.12",
    "multi-semantic-release": "3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "7.8.2",
    "semantic-release": "25.0.9",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "tslib": "2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitepress": "^1.6.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.3"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.0.7 <12"
  },
  "packageManager": "pnpm@11.0.7",
  "license": "MIT"
}
