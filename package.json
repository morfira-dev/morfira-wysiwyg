{
  "name": "morfira-wysiwyg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts && tsc -p packages/core && tsc -p packages/plugins && tsc -p packages/vue && tsc -p packages/react && pnpm --filter @morfira-dev/wysiwyg-svelte build && tsc -p packages/wysiwyg && tsx scripts/size.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./packages/svelte/tsconfig.json && vue-tsc --noEmit -p apps/docs/tsconfig.json",
    "test": "playwright test",
    "check": "pnpm run check:project && pnpm run build && pnpm run package:check && pnpm run typecheck && pnpm test",
    "release": "tsx scripts/release.ts",
    "docs:dev": "pnpm run build && vitepress dev apps/docs --host 127.0.0.1",
    "docs:build": "pnpm run build && vitepress build apps/docs",
    "docs:preview": "vite preview --outDir apps/docs/.vitepress/dist --host 127.0.0.1 --port 4173 --strictPort",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "check:project": "tsx scripts/check-project.ts",
    "release:plan": "tsx scripts/release.ts --dry-run",
    "test:release": "tsx scripts/tests/index.ts",
    "package:check": "tsx scripts/check-packages.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "esbuild": "^0.25.12",
    "multi-semantic-release": "3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semantic-release": "25.0.9",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitepress": "^1.6.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.3",
    "@morfira-dev/wysiwyg": "workspace:*"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.0.7 <12"
  },
  "packageManager": "pnpm@11.0.7",
  "license": "MIT"
}
