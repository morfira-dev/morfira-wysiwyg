{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@morfira/wysiwyg-core": [
        "./packages/core/src/index.ts"
      ],
      "@morfira/wysiwyg-vue": [
        "./packages/vue/src/index.ts"
      ],
      "@morfira/wysiwyg-react": [
        "./packages/react/src/index.tsx"
      ],
      "@morfira/wysiwyg-svelte": [
        "./packages/svelte/src/index.ts"
      ],
      "@morfira/wysiwyg-plugins/tables": [
        "./packages/plugins/src/tables.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "tests",
    "scripts",
    "*.ts"
  ]
}
