{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@morfira-dev/wysiwyg-core": [
        "./packages/core/src/index.ts"
      ],
      "@morfira-dev/wysiwyg-vue": [
        "./packages/vue/src/index.ts"
      ],
      "@morfira-dev/wysiwyg-react": [
        "./packages/react/src/index.tsx"
      ],
      "@morfira-dev/wysiwyg-svelte": [
        "./packages/svelte/src/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/tables": [
        "./packages/plugins/src/tables/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/images": [
        "./packages/plugins/src/images/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/search": [
        "./packages/plugins/src/search/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/statistics": [
        "./packages/plugins/src/statistics/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/markdown": [
        "./packages/plugins/src/markdown/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/mentions": [
        "./packages/plugins/src/mentions/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/slash": [
        "./packages/plugins/src/slash/index.ts"
      ],
      "@morfira-dev/wysiwyg-plugins/suggestions": [
        "./packages/plugins/src/suggestions/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "tests",
    "scripts",
    "*.ts"
  ]
}
